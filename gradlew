#!/usr/bin/env sh
##############################################################################
##
##  Gradle start up script for POSIX generated by Gradle.
##
##  Important for running:
##
##  (1) You need a POSIX-compliant shell to run this script.  If you
##      obtained a binary distribution (e.g., zip/tar.gz/bundle)
##      of Gradle, make sure you have a POSIX-compliant shell
##      available, e.g. GNU Bash.
##
##  (2) This script is generated by Gradle's wrapper task.
##
##############################################################################

# Attempt to set APP_HOME to the realpath of the script's directory.
PRG="$0"
while [ -h "$PRG" ]; do
  ls=$(ls -ld "$PRG")
  link=$(expr "$ls" : '.* -> \(.*\)$')
  if expr "$link" : '/.*' > /dev/null; then
    PRG="$link"
  else
    cd "$(dirname "$PRG")"
    PRG=$(basename "$link")
  fi
done
SELF=$(cd "$(dirname "$PRG")" && pwd)
APP_HOME=$(cd "$SELF" && pwd)

# Add default JVM options here. You can also use JAVA_OPTS and GRADLE_OPTS to pass JVM options to this script.
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

# Find java.exe and set the JAVA_HOME variable
if [ -n "$JAVA_HOME" ] ; then
  if [ -x "$JAVA_HOME/bin/java" ] ; then
    JAVACMD="$JAVA_HOME/bin/java"
  else
    JAVACMD="$JAVA_HOME/java"
  fi
else
  JAVACMD="java"
fi

if [ ! -x "$JAVACMD" ] ; then
  echo "Error: JAVA_HOME is not set and no 'java' command could be found in your PATH." >&2
  echo "Please set the JAVA_HOME variable in your environment to match the" >&2
  echo "location of your Java installation." >&2
  exit 1
fi

# Parse command line options
while [ $# -gt 0 ]; do
  case "$1" in
    -d|--debug)
      shift
      ADDITIONAL_JVM_OPTS="-verbose:jni -Xdebug -Xnoagent -Djava.compiler=NONE -Xrunjdwp:transport=dt_socket,server=y,suspend=n,address=5005"
      ;;
    -x|--execute)
      shift
      ;;
    *)
      break
      ;;
  esac
  shift
done

# Set the distribution URL
WRAPPER_DISTRIBUTION_URL="https://services.gradle.org/distributions/gradle-9.6.1-bin.zip"

# Set the wrapper properties
WRAPPER_PROPERTIES_FILE="$APP_HOME/gradle/wrapper/gradle-wrapper.properties"

# Load properties if they exist
if [ -f "$WRAPPER_PROPERTIES_FILE" ]; then
  . "$WRAPPER_PROPERTIES_FILE"
fi

# Set distribution URL if not already set
if [ -z "$distributionUrl" ]; then
  distributionUrl="$WRAPPER_DISTRIBUTION_URL"
fi

# Set JVM options
JVM_OPTS="$DEFAULT_JVM_OPTS"
if [ -n "$GRADLE_OPTS" ]; then
  JVM_OPTS="$JVM_OPTS $GRADLE_OPTS"
fi
if [ -n "$JAVA_OPTS" ]; then
  JVM_OPTS="$JVM_OPTS $JAVA_OPTS"
fi

# Set the wrapper jar
WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

# Set the gradle user home
GRADLE_USER_HOME="${GRADLE_USER_HOME:-$APP_HOME/gradle/wrapper/dists}"

# Run the wrapper
exec "$JAVACMD" \
  $ADDITIONAL_JVM_OPTS \
  $JVM_OPTS \
  -classpath "$WRAPPER_JAR" \
  org.gradle.wrapper.GradleWrapperMain \
  "$@"
